{
  "schemaVersion": "1.0.0",
  "package": "@konitif/compliance",
  "intent": "Assess an identified subject from explicit evidence and versioned policies.",
  "clusters": [
    {
      "id": "evidence",
      "title": "Evidence and snapshots",
      "summary": "Capture facts without conflating them with a verdict.",
      "authority": "Collected evidence corpus.",
      "owns": [
        "evidence",
        "snapshots",
        "collection records"
      ],
      "doesNotOwn": [
        "policy"
      ],
      "workflow": [
        "Collect",
        "Identify",
        "Preserve"
      ],
      "sources": [
        "evidence.ts",
        "snapshots.ts",
        "collectorRunner.ts"
      ]
    },
    {
      "id": "policy",
      "title": "Policy and purity",
      "summary": "Express the rules that qualify evidence.",
      "authority": "Deterministic evaluation of a caller-provided versioned policy.",
      "owns": [
        "rules",
        "criteria"
      ],
      "doesNotOwn": [
        "observed facts"
      ],
      "workflow": [
        "Declare",
        "Evaluate",
        "Qualify"
      ],
      "sources": [
        "policy.ts",
        "purity.ts",
        "schema.ts"
      ]
    },
    {
      "id": "guidance",
      "title": "Reporting and guidance",
      "summary": "Explain results without changing the verdict.",
      "authority": "Derived explanatory projection.",
      "owns": [
        "rendering",
        "guidance"
      ],
      "doesNotOwn": [
        "canonical decision"
      ],
      "workflow": [
        "Read",
        "Explain",
        "Guide"
      ],
      "sources": [
        "render.ts",
        "guidance.ts"
      ]
    }
  ]
}
