{
  "name": "@konitif/compliance",
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.284.1",
  "private": false,
  "description": "Generic evidence, compliance reports and snapshot comparison for KONITIF-based systems.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeMouf/konitif-compliance.git"
  },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE.md",
    "dist",
    "src",
    "README.md",
    "package.json",
    "reference"
  ],
  "devDependencies": {
    "@types/node": "25.9.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici-types": "7.24.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build && npm test",
    "prepublishOnly": "node -e \"throw new Error('Publication is not enabled for this preparation')\""
  }
}
